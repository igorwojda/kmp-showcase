TEAM_ID=

PRODUCT_NAME=Kmpshowcase
// Name shown on the home screen
INFOPLIST_KEY_CFBundleDisplayName=KMP Showcase
// Shown in the location permission dialog
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription=KMP Showcase uses your approximate location to show the weather where you are.
PRODUCT_BUNDLE_IDENTIFIER=com.igorwojda.showcase.Kmpshowcase$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Tooling drops CLAUDE.md notes in source folders; synchronized groups would bundle them.
EXCLUDED_SOURCE_FILE_NAMES=CLAUDE.md
